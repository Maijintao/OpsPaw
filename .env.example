# 按实际上游填写模型名称、地址和凭据。
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=your-chat-model
CHAT_API_KEY=replace-with-chat-api-key
# 可选思考参数，是否支持取决于上游模型。
# CHAT_THINKING=disabled
# CHAT_REASONING_EFFORT=low
# CHAT_REASONING_SPLIT=true

EMBED_API_KEY=replace-with-embedding-api-key
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3
RERANK_API_KEY=replace-with-rerank-api-key
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 连接已有 MySQL 和 Milvus 服务；替换占位信息。
DATABASE_URL=mysql+asyncmy://opspaw:replace-with-db-password@127.0.0.1:3306/opspaw
TEST_DATABASE_URL=mysql+asyncmy://opspaw:replace-with-test-db-password@127.0.0.1:3306/opspaw_test
MILVUS_URI=http://127.0.0.1:19530

# 对外访问时设置账号与密码。
ACCESS_USER=admin
ACCESS_PASS=replace-with-access-password

# 可选演示工具。
MCP_MONITOR_URL=http://127.0.0.1:8101/mcp
MCP_LOGS_URL=http://127.0.0.1:8102/mcp

# 可选 Langfuse；使用实际实例生成的凭据。
# LANGFUSE_PUBLIC_KEY=replace-with-public-key
# LANGFUSE_SECRET_KEY=replace-with-secret-key
# LANGFUSE_BASE_URL=http://127.0.0.1:3000
